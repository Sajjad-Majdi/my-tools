{
  "manifest_version": 3,
  "name": "Browser Bridge",
  "version": "2.0.0",
  "description": "Lets local AI agents drive this Chrome profile through 127.0.0.1.",
  "background": { "service_worker": "bg.js" },
  "permissions": ["debugger", "tabs", "storage", "alarms", "identity", "identity.email"],
  "host_permissions": ["http://127.0.0.1/*"],
  "minimum_chrome_version": "116"
}
